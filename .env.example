# echo — environment configuration (copy to .env; .env is gitignored)

# Required for the synthesis stages (ticket + survey text generation).
# The review sampling and order-economics stages need NO key.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults live in src/echo/config.py):
# ECHO_MODEL=gpt-4o-mini
# ECHO_OFFLINE=false      # true -> use the deterministic offline stub generator (no API calls)

# PostgreSQL — where `python -m echo.db` loads the corpus.
# Default assumes a local server + a database named "echo" (user = your OS login).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/echo

# --- JWT authentication ---------------------------------------------------- #
# REQUIRED for anything real: the token-signing key. The code falls back to an
# insecure dev default and warns if this is unset — override it.
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=720        # token lifetime (default 12h)

# Demo accounts created by `python -m echo.auth seed` (change before any real use):
# SEED_COMPANY_EMAIL=admin@echo.example
# SEED_COMPANY_PASSWORD=admin123
# SEED_GENPOP_EMAIL=user@echo.example
# SEED_GENPOP_PASSWORD=user123
